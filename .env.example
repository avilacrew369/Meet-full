# Copy to `.env` and fill in real values. Never commit the filled-in file.
# Every variable below is read at runtime on the server, so each one must also
# be set in your deployment platform's environment settings — `.env` is
# gitignored and does not travel with the repo.

APP_NAME=Meeti
APP_URL=http://localhost:3000

# Postgres connection string (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs session cookies. Generate with: openssl rand -hex 32
# Must be >= 32 chars, or Better Auth logs a warning; if unset in production
# it throws "You are using the default secret".
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000/

# SMTP (Mailtrap sandbox in development)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

UPLOADTHING_TOKEN=

PUSHER_APPID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Exposed to the browser — safe to be public, must match the server values above
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Extra origins Better Auth should accept (comma-separated).
# Dev only: LAN address for phone testing.
TRUSTED_ORIGINS=
